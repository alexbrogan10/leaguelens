# Copy to .env and adjust. Never commit .env.

# Database: SQLite for local dev, Postgres in Docker/prod.
DATABASE_URL=sqlite:///./data/leaguelens.db
# DATABASE_URL=postgresql+psycopg://leaguelens:leaguelens@db:5432/leaguelens

# Sleeper client
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_MAX_RPS=10

# nflverse release downloads
NFLVERSE_BASE_URL=https://github.com/nflverse/nflverse-data/releases/download

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Worker refresh interval in minutes
REFRESH_INTERVAL_MINUTES=360
